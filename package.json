{
  "name": "damoclesgil.com.br",
  "version": "2.0.0",
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "start": "astro dev",
    "build": "astro check && astro build",
    "build2": "astro check && astro build && jampack ./dist",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check . --plugin=prettier-plugin-astro",
    "format": "prettier --write . --plugin=prettier-plugin-astro",
    "cz": "cz",
    "prepare": "husky",
    "lint": "eslint .",
    "out": "pnpm outdated",
    "att:libs": "pnpm up --latest"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/mdx": "6.0.3",
    "@astrojs/partytown": "2.1.7",
    "@astrojs/rss": "4.0.18",
    "@astrojs/vercel": "10.0.8",
    "@iconify-json/devicon": "1.2.62",
    "@iconify-json/logos": "1.2.11",
    "@iconify-json/mdi": "1.2.3",
    "@iconify-json/tabler": "1.2.35",
    "@iconify-json/vscode-icons": "1.2.55",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "6.4.5",
    "date-fns": "4.4.0",
    "fuse.js": "7.4.2",
    "github-slugger": "2.0.0",
    "globals": "17.6.0",
    "remark-collapse": "0.1.2",
    "remark-toc": "9.0.0",
    "satori": "0.26.0",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0"
  },
  "devDependencies": {
    "@astrojs/react": "5.0.7",
    "@astrojs/sitemap": "3.7.3",
    "@divriots/jampack": "0.34.1",
    "@tailwindcss/typography": "0.5.20",
    "@types/react": "19.2.17",
    "@typescript-eslint/parser": "8.61.0",
    "astro-eslint-parser": "1.4.0",
    "astro-icon": "1.1.5",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10.4.1",
    "eslint-plugin-astro": "1.7.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "prettier": "3.8.4",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.34.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,mdx,json,astro}": [
      "prettier --write --plugin=prettier-plugin-astro"
    ]
  }
}
